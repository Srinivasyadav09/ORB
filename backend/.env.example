APP_NAME=ORB — Online Raithu Bazaar API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Compose uses host=db; for local Uvicorn use host=localhost.
DATABASE_URL=postgresql+asyncpg://orb_user:orb_password@db:5432/orb_db
POSTGRES_DB=orb_db
POSTGRES_USER=orb_user
POSTGRES_PASSWORD=orb_password

# Development placeholder only. Generate a unique secret outside development.
JWT_SECRET_KEY=CHANGE_THIS_IN_DEVELOPMENT_MINIMUM_32_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
